# Copy to .env.local for development; set the same names in the host's
# environment for deploys. Everything here is NEXT_PUBLIC_ because everything
# here is genuinely public — there is no server-side secret in this app.

# The canonical origin. Drives canonical tags, hreflang, Open Graph URLs,
# robots.txt and the sitemap, so it must be the real production domain with no
# trailing slash. Falls back to the Vercel preview domain when unset.
NEXT_PUBLIC_SITE_URL=https://showoff-project.vercel.app

# Supabase. The URL is the project's address and the publishable key is the
# anon key: both are designed to ship to browsers, and both are useless without
# a row-level-security policy that admits them. Every query this app makes runs
# from the browser against those policies — there is no service-role key here,
# and there should never be one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
